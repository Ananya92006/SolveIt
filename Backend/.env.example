# ==============================================================================
# SolveIt Backend Environment Variables Template
# Copy this file to '.env' and fill in your actual credentials:
# cp .env.example .env
# ==============================================================================

# Server Port (default: 3000)
PORT=3000

# Environment Mode (development | production)
NODE_ENV=development

# Allowed Frontend Origin for CORS (e.g., http://localhost:5173 for local Vite dev)
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# MongoDB Database
# ------------------------------------------------------------------------------
# MongoDB connection URI (local or MongoDB Atlas connection string)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/solveit?retryWrites=true&w=majority
DB_CONNECT_STRING=mongodb+srv://<username>:<password>@<cluster-url>/solveit?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying JWT tokens
JWT_KEY=your_jwt_secret_key_here_change_me_in_production

# Passcode to unlock admin mode (/admin panel access and problem/video creation)
ADMIN_SECRET_KEY=admin123

# ------------------------------------------------------------------------------
# Redis Cache
# ------------------------------------------------------------------------------
# Redis password or connection URL (supports Redis Cloud, Upstash, or local Redis)
# Example for Redis Cloud: your_redis_password_here
# Example for local Redis: redis://localhost:6379
REDIS_PASS=your_redis_password_here

# ------------------------------------------------------------------------------
# Judge0 CE (RapidAPI) - Code Execution Engine
# ------------------------------------------------------------------------------
# RapidAPI key for Judge0 CE API to execute C++, Java, and JavaScript code
# Get your free key at: https://rapidapi.com/judge0-official/api/judge0-ce
JUDGE0_KEY=your_rapidapi_judge0_key_here

# ------------------------------------------------------------------------------
# Cloudinary - Video Tutorial Upload & Storage
# ------------------------------------------------------------------------------
# Cloudinary credentials for signed video uploads and streaming
# Get your credentials at: https://cloudinary.com (Dashboard -> API Keys)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# Google Gemini API (Optional)
# ------------------------------------------------------------------------------
# Gemini API key for AI-driven solution hints and algorithm advice
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_KEY=your_gemini_api_key_here
